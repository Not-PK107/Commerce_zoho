# Zoho Commerce Storefront Configuration (India DC)
VITE_ZOHO_STOREFRONT_DOMAIN=your_storefront_domain
VITE_ZOHO_ORG_ID=your_org_id
VITE_ZOHO_STORE_ID=your_store_id
VITE_ZOHO_STOREFRONT_API_BASE=https://commerce.zoho.in/storefront/api/v1
VITE_ZOHO_ADMIN_API_BASE=https://commerce.zoho.in/store/api/v1

# Use local Vite proxy during development to handle CORS and cookie session management
VITE_USE_PROXY=true

# ==============================================================================
# ZOHO COMMERCE ADMIN API OAUTH CREDENTIALS (SERVER-SIDE ONLY - NEVER EXPOSED)
# ==============================================================================
# Add your Zoho OAuth access token here to fetch real products from your Zoho store.
# Required Scope: ZohoCommerce.items.READ
# Organization ID: Your_Org_Id
ZOHO_ADMIN_ACCESS_TOKEN=Admin_access_token

# Optional: Configure for automatic 60-minute token renewal
# ZOHO_CLIENT_ID=your_client_id
# ZOHO_CLIENT_SECRET=your_client_secret
# ZOHO_REFRESH_TOKEN=_your_refresh_token
