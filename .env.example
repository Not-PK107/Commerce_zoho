# Shopify Storefront GraphQL API Endpoint
# Default mock backend: https://mock.shop/api
# When transitioning to a production Shopify store, set this to:
# https://{your-shop-name}.myshopify.com/api/2024-01/graphql
VITE_SHOPIFY_API_URL=https://mock.shop/api

# Shopify Storefront Access Token (public / storefront only - never private admin tokens)
# For mock.shop, 'public' or leave blank.
VITE_SHOPIFY_STOREFRONT_TOKEN=public
